# API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database Configuration (PostgreSQL)
# Ganti dengan connection string asli Anda di .env.local
DATABASE_URL="postgresql://user:password@localhost:5432/dengarbain?schema=public"

# Cloudflare R2 Credentials
# Ganti dengan key dari panel Cloudflare Anda
R2_ACCESS_KEY_ID="your_access_key_here"
R2_SECRET_ACCESS_KEY="your_secret_key_here"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="dengarbain-audio"
NEXT_PUBLIC_AUDIO_CDN_URL="https://cdn.domainanda.com"
